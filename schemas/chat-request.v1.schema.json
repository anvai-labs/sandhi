{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChatRequestV1",
  "type": "object",
  "required": [
    "messages",
    "model"
  ],
  "properties": {
    "cache_intent": {
      "anyOf": [
        {
          "$ref": "#/definitions/CacheIntentV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "include_native_response": {
      "description": "Whether adapters re-embed the full native provider response body under `extensions[<endpoint family>]` on the response. Defaults to true for compatibility; clients that consume only the neutral contract can opt out to shed bandwidth and coupling (G8). The `reasoning` extension is unaffected — it is decoded content, not a native body.",
      "type": "boolean"
    },
    "include_native_stream": {
      "description": "Opt in to protocol-native SSE frame events alongside canonical metering events. Default off so existing neutral stream consumers keep their event set.",
      "type": "boolean"
    },
    "max_output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ChatMessageV1"
      }
    },
    "metadata": {
      "default": {},
      "allOf": [
        {
          "$ref": "#/definitions/RequestMetadataV1"
        }
      ]
    },
    "model": {
      "type": "string"
    },
    "native_input": {
      "description": "Codec-owned native input and portable-projection consistency fence. The original input remains in the matching extensions bucket, in wire order.",
      "anyOf": [
        {
          "$ref": "#/definitions/NativeInputV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "response_format": true,
    "schema_version": {
      "default": "1",
      "type": "string"
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "stop": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "temperature": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "thinking": {
      "description": "Unified semantic thinking control. Vendor spellings are normalized at ingress and restored by an explicitly qualified model encoding profile.",
      "anyOf": [
        {
          "$ref": "#/definitions/ThinkingRequestV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "tool_choice": {
      "anyOf": [
        {
          "$ref": "#/definitions/ToolChoiceV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ToolDefinitionV1"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CacheIntentV1": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "lifetime": {
          "anyOf": [
            {
              "$ref": "#/definitions/CacheLifetimeV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "$ref": "#/definitions/CacheModeV1"
        }
      },
      "additionalProperties": false
    },
    "CacheLifetimeV1": {
      "type": "string",
      "enum": [
        "5m",
        "1h",
        "30m",
        "12h",
        "in_memory",
        "24h"
      ]
    },
    "CacheModeV1": {
      "type": "string",
      "enum": [
        "preserve_native",
        "auto",
        "auto_stable_prefix",
        "auto_conversation_prefix",
        "suppress_gateway"
      ]
    },
    "ChatMessageV1": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "content",
            "role"
          ],
          "properties": {
            "content": {
              "$ref": "#/definitions/MessageContent"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "role": {
              "type": "string",
              "enum": [
                "developer"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "content",
            "role"
          ],
          "properties": {
            "content": {
              "$ref": "#/definitions/MessageContent"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "role": {
              "type": "string",
              "enum": [
                "system"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "content",
            "role"
          ],
          "properties": {
            "content": {
              "$ref": "#/definitions/MessageContent"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "role": {
              "type": "string",
              "enum": [
                "user"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "role"
          ],
          "properties": {
            "content": {
              "anyOf": [
                {
                  "$ref": "#/definitions/MessageContent"
                },
                {
                  "type": "null"
                }
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "refusal": {
              "type": [
                "string",
                "null"
              ]
            },
            "role": {
              "type": "string",
              "enum": [
                "assistant"
              ]
            },
            "tool_calls": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ToolCallV1"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "content",
            "role",
            "tool_call_id"
          ],
          "properties": {
            "content": {
              "$ref": "#/definitions/MessageContent"
            },
            "role": {
              "type": "string",
              "enum": [
                "tool"
              ]
            },
            "tool_call_id": {
              "type": "string"
            }
          }
        },
        {
          "description": "Legacy Chat Completions function result; retained for lossless compatibility.",
          "type": "object",
          "required": [
            "content",
            "name",
            "role"
          ],
          "properties": {
            "content": {
              "$ref": "#/definitions/MessageContent"
            },
            "name": {
              "type": "string"
            },
            "role": {
              "type": "string",
              "enum": [
                "function"
              ]
            }
          }
        }
      ]
    },
    "ContentPart": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "text",
            "type"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "text"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "image_url",
            "type"
          ],
          "properties": {
            "detail": {
              "type": [
                "string",
                "null"
              ]
            },
            "image_url": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "image_url"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "data",
            "format",
            "type"
          ],
          "properties": {
            "data": {
              "type": "string"
            },
            "format": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "input_audio"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "file_data": {
              "type": [
                "string",
                "null"
              ]
            },
            "file_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "filename": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "file"
              ]
            }
          }
        }
      ]
    },
    "EndpointFamilyV1": {
      "type": "string",
      "enum": [
        "openai_chat_completions",
        "openai_responses",
        "anthropic_messages",
        "gemini_generate_content",
        "cohere_chat",
        "ollama_chat",
        "bedrock_converse",
        "host_callback"
      ]
    },
    "MessageContent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ContentPart"
          }
        }
      ]
    },
    "NativeInputFeatureV1": {
      "type": "string",
      "enum": [
        "opaque_state",
        "resource_reference",
        "unsupported_content",
        "native_control"
      ]
    },
    "NativeInputV1": {
      "type": "object",
      "required": [
        "endpoint_family",
        "projection_sha256"
      ],
      "properties": {
        "endpoint_family": {
          "$ref": "#/definitions/EndpointFamilyV1"
        },
        "nonportable_features": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NativeInputFeatureV1"
          }
        },
        "projection_sha256": {
          "description": "SHA-256 of native input fields, portable messages/tools/choice and feature flags. Excludes resolved model, output bounds and authenticated attribution.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RequestMetadataV1": {
      "type": "object",
      "properties": {
        "group_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "idempotency_key": {
          "description": "Caller-supplied key for at-most-once semantics across retries of one logical call.",
          "type": [
            "string",
            "null"
          ]
        },
        "parent_id": {
          "description": "Parent step/run for nested agents, so an agent's cost tree is reconstructable.",
          "type": [
            "string",
            "null"
          ]
        },
        "route": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "description": "Agent-run identifier; groups every call one run makes (cost-tree root).",
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "step_id": {
          "description": "Step within a run (plan/act/verify…); child dimension under `run_id`.",
          "type": [
            "string",
            "null"
          ]
        },
        "subject_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "trace_context": {
          "description": "W3C `traceparent` value, linking the call into distributed traces.",
          "type": [
            "string",
            "null"
          ]
        },
        "virtual_key_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ThinkingRequestV1": {
      "description": "One neutral thinking request. Omission on `ChatRequestV1` means the model default; an explicit object is validated against exact model capability.",
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "budget_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "ToolCallV1": {
      "type": "object",
      "required": [
        "arguments",
        "id",
        "name"
      ],
      "properties": {
        "arguments": {
          "description": "JSON object encoded as a string, retained incrementally and losslessly across streams.",
          "type": "string"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "ToolChoiceMode": {
      "type": "string",
      "enum": [
        "none",
        "auto",
        "required"
      ]
    },
    "ToolChoiceV1": {
      "anyOf": [
        {
          "$ref": "#/definitions/ToolChoiceMode"
        },
        {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            }
          }
        }
      ]
    },
    "ToolDefinitionV1": {
      "type": "object",
      "required": [
        "name",
        "parameters"
      ],
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "parameters": true,
        "strict": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    }
  }
}
