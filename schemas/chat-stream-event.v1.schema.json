{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChatStreamEventV1",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "event",
        "model"
      ],
      "properties": {
        "event": {
          "type": "string",
          "enum": [
            "response_start"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "delta",
        "event"
      ],
      "properties": {
        "delta": {
          "type": "string"
        },
        "event": {
          "type": "string",
          "enum": [
            "text_delta"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "delta",
        "event"
      ],
      "properties": {
        "delta": {
          "type": "string"
        },
        "event": {
          "type": "string",
          "enum": [
            "reasoning_delta"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "delta",
        "event"
      ],
      "properties": {
        "delta": {
          "type": "string"
        },
        "event": {
          "type": "string",
          "enum": [
            "refusal_delta"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "event",
        "id",
        "index",
        "name"
      ],
      "properties": {
        "event": {
          "type": "string",
          "enum": [
            "tool_call_start"
          ]
        },
        "id": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "name": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "delta",
        "event",
        "index"
      ],
      "properties": {
        "delta": {
          "type": "string"
        },
        "event": {
          "type": "string",
          "enum": [
            "tool_call_arguments_delta"
          ]
        },
        "index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    {
      "type": "object",
      "required": [
        "event",
        "index"
      ],
      "properties": {
        "event": {
          "type": "string",
          "enum": [
            "tool_call_end"
          ]
        },
        "index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    {
      "type": "object",
      "required": [
        "event",
        "usage"
      ],
      "properties": {
        "event": {
          "type": "string",
          "enum": [
            "usage"
          ]
        },
        "usage": {
          "$ref": "#/definitions/UsageV2"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "event",
        "reason"
      ],
      "properties": {
        "event": {
          "type": "string",
          "enum": [
            "finish"
          ]
        },
        "reason": {
          "$ref": "#/definitions/FinishReasonV1"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "error",
        "event"
      ],
      "properties": {
        "error": {
          "$ref": "#/definitions/ProviderErrorV1"
        },
        "event": {
          "type": "string",
          "enum": [
            "error"
          ]
        }
      }
    }
  ],
  "definitions": {
    "CacheReadObservation": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "source": {
              "const": "origin_usage"
            },
            "status": {
              "enum": [
                "reported",
                "absent",
                "malformed"
              ]
            }
          }
        },
        {
          "properties": {
            "source": {
              "const": "caller_supplied"
            },
            "status": {
              "enum": [
                "reported"
              ]
            }
          }
        },
        {
          "properties": {
            "source": {
              "const": "explicit_capability"
            },
            "status": {
              "enum": [
                "unsupported"
              ]
            }
          }
        }
      ],
      "required": [
        "source",
        "status"
      ],
      "properties": {
        "source": {
          "$ref": "#/definitions/CacheReadSource"
        },
        "status": {
          "$ref": "#/definitions/CacheReadStatus"
        }
      }
    },
    "CacheReadSource": {
      "type": "string",
      "enum": [
        "origin_usage",
        "caller_supplied",
        "explicit_capability"
      ]
    },
    "CacheReadStatus": {
      "type": "string",
      "enum": [
        "reported",
        "absent",
        "malformed",
        "unsupported"
      ]
    },
    "FinishReasonV1": {
      "type": "string",
      "enum": [
        "stop",
        "length",
        "tool_calls",
        "content_filter",
        "function_call",
        "unknown"
      ]
    },
    "LatencySource": {
      "description": "Which side of the provider boundary measured a latency field (TD-0027 S4).",
      "oneOf": [
        {
          "description": "Reported by the model-serving origin in its response usage object.",
          "type": "string",
          "enum": [
            "origin"
          ]
        },
        {
          "description": "Measured by Sandhi around the provider call because the origin omitted the field.",
          "type": "string",
          "enum": [
            "boundary"
          ]
        }
      ]
    },
    "ProviderErrorV1": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0.0
        },
        "message": {
          "type": "string"
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "UsageBasis": {
      "description": "Where a usage number came from (TD-0013 D5).\n\nOrthogonal to [`UsageCompleteness`], which answers *how complete* the counts are. This answers *whether they were measured at all* — and the two are genuinely independent: an interrupted stream can carry real provider counts (`Partial` + `ProviderReported`) or a byte-derived floor (`Partial` + `Estimated`), and today nothing on the wire tells them apart.\n\nDeliberately a separate field rather than a fourth `UsageCompleteness` variant: redefining what `Partial` means would retroactively change the meaning of rows already written to operators' stores, without changing a single byte of schema. Adding a field does not.",
      "oneOf": [
        {
          "description": "Every category came from the provider. The default, because it is what every code path that existed before this discriminator was introduced actually did.",
          "type": "string",
          "enum": [
            "provider_reported"
          ]
        },
        {
          "description": "At least one category was derived from a byte count rather than reported. Reached only when a stream ends before the family had reported that category — never on a completed call.",
          "type": "string",
          "enum": [
            "estimated"
          ]
        }
      ]
    },
    "UsageCompleteness": {
      "type": "string",
      "enum": [
        "final",
        "partial",
        "unavailable"
      ]
    },
    "UsageV2": {
      "type": "object",
      "required": [
        "cache_creation_tokens",
        "cache_read_tokens",
        "tokens_in",
        "tokens_out"
      ],
      "properties": {
        "accepted_prediction_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "attempts": {
          "default": 1,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "audio_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "audio_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "basis": {
          "description": "Whether these counts were measured or estimated (TD-0013 D5).",
          "default": "provider_reported",
          "allOf": [
            {
              "$ref": "#/definitions/UsageBasis"
            }
          ]
        },
        "cache_creation_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "cache_read_observation": {
          "anyOf": [
            {
              "$ref": "#/definitions/CacheReadObservation"
            },
            {
              "type": "null"
            }
          ]
        },
        "cache_read_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "completeness": {
          "default": "unavailable",
          "allOf": [
            {
              "$ref": "#/definitions/UsageCompleteness"
            }
          ]
        },
        "duration_ms": {
          "description": "Wall-clock call duration. Origin-reported when available; otherwise measured at Sandhi's typed boundary (TD-0027 S4).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "duration_source": {
          "description": "Provenance for `duration_ms`; absent only on legacy/unmeasured records.",
          "anyOf": [
            {
              "$ref": "#/definitions/LatencySource"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasoning_included": {
          "description": "True: reasoning is included in tokens_out; false: add it separately. Absent retains legacy magnitude-based accounting for old records only.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "rejected_prediction_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "time_to_first_token_ms": {
          "description": "Time from request dispatch to the first streamed event (streaming only). Origin-reported when available; otherwise measured at Sandhi's typed boundary.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "time_to_first_token_source": {
          "description": "Provenance for `time_to_first_token_ms`; absent only on legacy/unmeasured records.",
          "anyOf": [
            {
              "$ref": "#/definitions/LatencySource"
            },
            {
              "type": "null"
            }
          ]
        },
        "tokens_in": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "tokens_out": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "upstream_request_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
