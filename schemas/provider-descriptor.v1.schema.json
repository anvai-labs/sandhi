{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProviderDescriptorV1",
  "type": "object",
  "required": [
    "base_url",
    "endpoint_family",
    "slug"
  ],
  "properties": {
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "base_url": {
      "type": "string"
    },
    "capabilities": {
      "default": {
        "audio_input": false,
        "file_input": false,
        "parallel_tool_calls": false,
        "prompt_cache_usage": false,
        "reasoning": false,
        "streaming": false,
        "structured_output": false,
        "tools": false,
        "vision": false
      },
      "allOf": [
        {
          "$ref": "#/definitions/ProviderCapabilitiesV1"
        }
      ]
    },
    "endpoint_family": {
      "$ref": "#/definitions/EndpointFamilyV1"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ModelDescriptorV1"
      }
    },
    "schema_version": {
      "default": "1",
      "type": "string"
    },
    "slug": {
      "type": "string"
    }
  },
  "definitions": {
    "EndpointFamilyV1": {
      "type": "string",
      "enum": [
        "openai_chat_completions",
        "openai_responses",
        "anthropic_messages",
        "gemini_generate_content",
        "cohere_chat",
        "ollama_chat",
        "bedrock_converse",
        "host_callback"
      ]
    },
    "ModelDescriptorV1": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "default": {
            "audio_input": false,
            "file_input": false,
            "parallel_tool_calls": false,
            "prompt_cache_usage": false,
            "reasoning": false,
            "streaming": false,
            "structured_output": false,
            "tools": false,
            "vision": false
          },
          "allOf": [
            {
              "$ref": "#/definitions/ProviderCapabilitiesV1"
            }
          ]
        },
        "default_temperature": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "endpoint_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        },
        "id": {
          "type": "string"
        },
        "max_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "thinking": {
          "description": "Omission means the model cannot configure thinking. An explicit unsupported descriptor serializes identically.",
          "default": {
            "supported": false
          },
          "allOf": [
            {
              "$ref": "#/definitions/ThinkingCapabilityV1"
            }
          ]
        }
      }
    },
    "ProviderCapabilitiesV1": {
      "type": "object",
      "properties": {
        "audio_input": {
          "default": false,
          "type": "boolean"
        },
        "file_input": {
          "default": false,
          "type": "boolean"
        },
        "parallel_tool_calls": {
          "default": false,
          "type": "boolean"
        },
        "prompt_cache_usage": {
          "default": false,
          "type": "boolean"
        },
        "reasoning": {
          "default": false,
          "type": "boolean"
        },
        "streaming": {
          "default": false,
          "type": "boolean"
        },
        "structured_output": {
          "default": false,
          "type": "boolean"
        },
        "tools": {
          "default": false,
          "type": "boolean"
        },
        "vision": {
          "default": false,
          "type": "boolean"
        }
      }
    },
    "ThinkingBudgetCapabilityV1": {
      "description": "Canonical token-budget bounds accepted by an exact model.",
      "type": "object",
      "required": [
        "max",
        "min"
      ],
      "properties": {
        "max": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "min": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "ThinkingCapabilityV1": {
      "description": "Exact model-scoped thinking control facts.",
      "type": "object",
      "required": [
        "supported"
      ],
      "properties": {
        "allow_effort_and_budget": {
          "type": "boolean"
        },
        "budget_tokens": {
          "anyOf": [
            {
              "$ref": "#/definitions/ThinkingBudgetCapabilityV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "can_disable": {
          "type": "boolean"
        },
        "effort": {
          "anyOf": [
            {
              "$ref": "#/definitions/ThinkingEffortCapabilityV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "encoding": {
          "anyOf": [
            {
              "$ref": "#/definitions/ThinkingEncodingV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "supported": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "ThinkingEffortCapabilityV1": {
      "description": "Canonical effort values accepted by an exact model. Compatibility aliases are intentionally not modeled; callers send one of these advertised values.",
      "type": "object",
      "required": [
        "values"
      ],
      "properties": {
        "default": {
          "type": [
            "string",
            "null"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "ThinkingEncodingV1": {
      "description": "Canonical transport encoding for an admitted thinking control. This is a closed enum by design; operators qualify a model, they cannot invent JSON paths.",
      "type": "string",
      "enum": [
        "openai_chat",
        "openai_responses",
        "anthropic_messages",
        "gemini_generate_content",
        "qwen_openai_chat",
        "zai_openai_chat"
      ]
    }
  }
}
