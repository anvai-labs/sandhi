#!/usr/bin/env bash
# Fast pre-push gate (no compile), modeled on proximaDB's pre-push. Activate with:
#   git config core.hooksPath .githooks
# Enforces a commit-bound independent-review record and rustfmt.
# Bypass once with `git push --no-verify`.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
python3 "$repo_root/scripts/adversarial_review.py" --repo "$repo_root" check-push

if command -v cargo >/dev/null 2>&1; then
  if ! cargo fmt --all -- --check >/dev/null 2>&1; then
    echo "pre-push: BLOCKED — rustfmt drift. Run: cargo fmt --all   (bypass: git push --no-verify)" >&2
    exit 1
  fi
fi

echo "pre-push: OK (review + fmt)"
